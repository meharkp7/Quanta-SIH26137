# Copy to .env.local, fill these two public values, then restart Vite / rebuild.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Map tile overlay only (HERE raster traffic tiles on the leaflet map).
# Place-search / live graph speeds use the BACKEND key instead — set
# HERE_API_KEY in the repo-root .env (see ../.env.example).
VITE_HERE_API_KEY=
