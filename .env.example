# API also reads frontend/.env.local for local use.
# Set these on the backend host when deploying separately.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
QUANTA_ALLOW_DEMO=true
QUANTA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8765

# Optional HERE integration (geocoding, HERE routing, live traffic speeds).
# Free key: https://portal.here.com -> "Access keys". Without it everything
# still works; /api/here/* reports a clear reason instead of fake data.
HERE_API_KEY=
